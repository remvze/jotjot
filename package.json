{
  "name": "jotjot",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "jot": "dist/bin/app.js"
  },
  "main": "dist/bin/app.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remvze/jotjot.git"
  },
  "homepage": "https://github.com/remvze/jotjot#readme",
  "bugs": {
    "url": "https://github.com/remvze/jotjot/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "prepare": "husky",
    "commit": "git-cz",
    "release": "standard-version --no-verify",
    "release:major": "pnpm run release --release-as major",
    "release:minor": "pnpm run release --release-as minor",
    "release:patch": "pnpm run release --release-as patch",
    "build": "tsup-node",
    "dev": "tsup-node --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cli",
    "notes",
    "note-taking",
    "jot",
    "terminal",
    "productivity"
  ],
  "author": "Maze",
  "license": "MIT",
  "description": "A minimal CLI for quickly jotting down notes.",
  "devDependencies": {
    "@biomejs/biome": "2.0.6",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@tsconfig/node20": "^20.1.6",
    "@types/node": "^24.0.10",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.2",
    "standard-version": "9.5.0",
    "tsup": "8.5.0"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.2",
    "chalk": "6.0.0",
    "commander": "14.0.0",
    "fuse.js": "7.5.0",
    "lowdb": "7.0.1",
    "nanoid": "6.0.1"
  }
}
